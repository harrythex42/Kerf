#!/bin/sh
set -eu
export PATH="$(dirname "$0")/../node_modules/.bin:/opt/homebrew/bin:/usr/local/bin:$PATH"
cd "$(dirname "$0")/.."
if ! command -v node >/dev/null 2>&1; then
  echo '[Kerf] 请先安装 Node.js 22 或更新版本。' >&2
  exit 1
fi
if [ ! -d packages/mcp/node_modules ] || [ ! -f packages/playwright/dist/index.js ]; then
  echo '[Kerf] 第一次启动，正在安装依赖和构建项目。' >&2
  if command -v pnpm >/dev/null 2>&1; then
    pnpm install --frozen-lockfile >&2
    pnpm build >&2
  else
    npx --yes pnpm@12.3.4 install --frozen-lockfile >&2
    npx --yes pnpm@12.3.4 build >&2
  fi
fi
exec node packages/mcp/server.mjs
