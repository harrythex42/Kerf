#!/bin/sh
set -eu
export PATH="$(dirname "$0")/../node_modules/.bin:/opt/homebrew/bin:/usr/local/bin:$PATH"
cd "$(dirname "$0")/.."
if ! command -v node >/dev/null 2>&1; then
  echo '[Unsliced] 请先安装 Node.js 22 或更新版本。' >&2
  exit 1
fi
if [ ! -d node_modules/@modelcontextprotocol/sdk ] || [ ! -d node_modules/playwright ]; then
  echo '[Unsliced] 第一次启动，正在安装依赖。' >&2
  if command -v pnpm >/dev/null 2>&1; then
    pnpm install --frozen-lockfile >&2
  else
    npx --yes pnpm@12.3.4 install --frozen-lockfile >&2
  fi
fi
exec node server.mjs
